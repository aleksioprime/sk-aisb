# Скопируйте в .env и задайте свои пароли.
POSTGRES_USER=umka
POSTGRES_PASSWORD=change-me
POSTGRES_DB=umka
DATABASE_URL=postgresql+asyncpg://umka:change-me@postgres:5432/umka

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# + — идентификатор устройства, второй уровень — тип сообщения (event, status).
MQTT_TOPIC=umka/+/+

TZ=Europe/Moscow

# Подпись токенов входа на сайт: длинная случайная строка.
JWT_SECRET_KEY=change-me-to-a-long-random-string
